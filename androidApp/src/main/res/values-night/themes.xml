<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SignalBrief" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash/launch theme in dark mode uses the same SignalBrief blue. -->
    <style name="Theme.SignalBrief.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/signal_brief_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_silhouette</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.SignalBrief</item>
        <item name="android:statusBarColor">@color/signal_brief_primary</item>
        <item name="android:navigationBarColor">@color/signal_brief_primary</item>
    </style>
</resources>
