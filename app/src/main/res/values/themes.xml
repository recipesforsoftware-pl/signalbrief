<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Main application theme. The starting/splash theme is declared separately
      and set on the launcher Activity in the manifest; the SplashScreen library
      swaps to this theme immediately after the first frame is drawn.
    -->
    <style name="Theme.MVVMNews" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Splash/launch theme for Android 12+ (backported to API 21 via
      androidx.core:core-splashscreen). Uses the SignalBrief blue brand color
      and the white Sigby silhouette icon centered on the splash window.
    -->
    <style name="Theme.MVVMNews.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E5ABE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_silhouette</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.MVVMNews</item>
        <item name="android:statusBarColor">#1E5ABE</item>
        <item name="android:navigationBarColor">#1E5ABE</item>
    </style>
</resources>
